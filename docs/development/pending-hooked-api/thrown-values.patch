  * Maps log levels to their display colors
  * ERROR=red, WARN=yellow, etc. for quick visual identification
  */
+function logFailure (logger, message, error, details, context) {
+  try {
+    logger.error(message, { ...details, error: errorMessage(error) })
+  } catch (loggingError) {
+    (context.cleanupErrors ||= []).push({ phase: 'logging', error: loggingError })
+  }
+}
+
+function errorMessage (error) {
+  try {
+    const message = error?.message
+    return typeof message === 'string' ? message : String(error)
+  } catch {
+    return 'Non-Error value thrown'
+  }
+}
