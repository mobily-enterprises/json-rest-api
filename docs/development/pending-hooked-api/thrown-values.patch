+++ b/tests/test-thrown-values.test.js
@@ -0,0 +1,50 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { Api, ValidationError } from '../index.js'
+
+const values = [null, undefined, false, 0, 'failure', Object.freeze(new Error('Frozen')), new ValidationError('Typed'), Object.create(null)]
+for (const [index, value] of values.entries()) {
+  for (const boundary of ['api', 'scope', 'hook']) {
+    test(`${boundary} preserves thrown value ${index}`, async () => {
+      const api = new Api({ name: 'throw-test', logging: { level: 'error', logger: { log () {}, warn () {}, error () {} } } })
+      const fail = () => { throw value }
+      await api.customize({
+        apiMethods: { fail },
+        scopeMethods: { fail, viaHook: ({ runHooks }) => runHooks('failure') },
+        hooks: { failure: { functionName: 'throw-value', handler: fail } }
+      })
+      await api.addScope('items', {})
+      const invoke = boundary === 'api' ? () => api.fail() : boundary === 'scope' ? () => api.scopes.items.fail() : () => api.scopes.items.viaHook()
+      let rejected = false
+      try { await invoke() } catch (error) { rejected = true; assert.equal(error, value) }
+      assert.equal(rejected, true)
+    })
+  }
+}
+
+for (const [index, primary] of [null, undefined, Object.freeze(new Error('Frozen')), new ValidationError('Typed')].entries()) {
+  for (const secondary of [new Error('Logger failed'), null]) {
+    for (const boundary of ['api', 'scope', 'hook']) {
+      test(`${boundary} keeps primary ${index} when logging throws ${String(secondary)}`, async () => {
+        const context = {}
+        const api = new Api({ name: 'log-failure-test', logging: {
+          level: 'error', logger: { log () {}, warn () {}, error () { throw secondary } }
+        } })
+        const fail = () => { throw primary }
+        await api.customize({
+          apiMethods: { fail },
+          scopeMethods: { fail, viaHook: ({ runHooks }) => runHooks('failure') },
+          hooks: { failure: { functionName: 'throw-value', handler: fail } }
+        })
+        await api.addScope('items', {})
+        const invoke = boundary === 'api'
+          ? () => api.fail({}, context)
+          : boundary === 'scope' ? () => api.scopes.items.fail({}, context) : () => api.scopes.items.viaHook({}, context)
+        let rejected = false
+        try { await invoke() } catch (error) { rejected = true; assert.equal(error, primary) }
+        assert.equal(rejected, true)
+        assert.deepEqual(context.cleanupErrors, Array.from({ length: boundary === 'hook' ? 2 : 1 }, () => ({ phase: 'logging', error: secondary })))
+      })
+    }
+  }
+}
